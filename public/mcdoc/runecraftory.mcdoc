// ===== Registry End =====

dispatch minecraft:resource[runecraftory:crops] to struct Crops {
	crop: struct CropInfo {
		seed: ItemHolderSet,
		crop: ItemHolderSet,
		crop_block: BlockHolderSet,
		giant_crop?: struct GiantCropInfo {
			item: #[id="item"] string,
			block: #[id="block"] string,
		}
	},
	growth: int @ 1..,
	max_drops: int @ 0..,
	regrowable: boolean,
	best_season?: [("SPRING" | "SUMMER" | "FALL" | "WINTER")],
	bad_season?: [("SPRING" | "SUMMER" | "FALL" | "WINTER")],
}

dispatch minecraft:resource[runecraftory:food] to struct Food {
	item: #[id=(registry="item", tags="allowed")] string,
	duration: int @ 0..,
	effects: struct {
		[AttributeIDS]: double,
	},
	effects_percentage: struct {
		[AttributeIDS]: double,
	},
	cooking_bonus: struct {
		[AttributeIDS]: double,
	},
	cookingBonus_percent: struct {
		[AttributeIDS]: double,
	},
	potion_apply: [struct {
		item: #[id="mob_effect"] string,
		duration: int @ 1..,
		amplifier: int,
	}],
	potion_remove: [#[id="mob_effect"] string],
}

dispatch minecraft:resource[runecraftory:farmland_hoe_tile_action] to struct FarmlandTilingData {
	item: #[id=(registry="item")] string,
	amount: int,
}

type StructureID = (#[until="1.19"] #[id="worldgen/configured_structure_feature"] string |
		 #[since="1.19"] #[id="worldgen/structure"] string)

dispatch minecraft:resource[runecraftory:gate_spawn] to struct GateSpawning {
	entity: #[id=(registry="entity_type")] string,
	min_distance_from_spawn:  int @ 0..,
	min_gate_level: int @ 0..,
	allow_underwater: boolean,
	biomes: struct {
		[#[id="worldgen/biome"] string]: int @ 1..,
	},
	structures: struct {
		[StructureID]: int @ 1..,
	},
	gate_predicate?: EntityPredicate,
	player_predicate?: EntityPredicate,
}

dispatch minecraft:resource[runecraftory:item_property] to struct ItemStats {
	item: #[id=(registry="item", tags="allowed")] string,
	buy_price:  int @ 0..,
	sell_price:  int @ 0..,
	upgrade_difficulty:  int @ 0..,
	element: ("NONE" | "WATER" | "EARTH" | "WIND" | "FIRE" | "LIGHT" | "DARK" | "LOVE"),
	item_stats:  struct {
		[AttributeIDS]: double,
	},
	tier_1_Spell?: #[id] #[dispatcher_key="runecraftory:spells"] string,
	tier_2_Spell?: #[id] #[dispatcher_key="runecraftory:spells"] string,
	tier_3_Spell?: #[id] #[dispatcher_key="runecraftory:spells"] string,
	armor_effect?:  #[id] #[dispatcher_key="runecraftory:armor_effects"] string,
	monster_bonus:  struct {
		[AttributeIDS]: double,
	},
}

dispatch minecraft:resource[runecraftory:shop_item] to struct ShopItems {
	replace: boolean,
	values: [ShopItemsContent],
}

struct ShopItemsContent {
	item: ((#[id=(registry="item", tags="allowed")] string | ItemStack) | [((#[id=(registry="item")] string) | ItemStack)]),
	unlock_type: ("DEFAULT" | "ALWAYS" | "NEEDS_SHIPPING"),
	predicate?: EntityPredicate,
}

// ===== NPC Stuff =====

dispatch minecraft:resource[runecraftory:npc_gift] to struct GiftData {
	items: [#[id=(registry="item", tags="allowed")] string] @ 1..,
	xp_range?: struct {
		min?: int,
		max?: int,
	},
	translations: [string] @ 1..,
}

dispatch runecraftory:npc_actions[runecraftory:do_nothing] to struct {
}
dispatch runecraftory:npc_actions[runecraftory:walk_to] to struct {
	walk_speed: float,
	close_enough: int @ 0..,
}
dispatch runecraftory:npc_actions[runecraftory:walk_away] to struct {
	walk_speed: float,
	min_distance: float,
	radius: int @ 0..,
}
dispatch runecraftory:npc_actions[runecraftory:keep_distance] to struct {
	walk_speed: float,
	min: float,
	max: float,
}
dispatch runecraftory:npc_actions[runecraftory:random_walk] to struct {
	walk_speed: float,
	radius: int @ 0..,
}
dispatch runecraftory:npc_actions[runecraftory:walk_to_follow] to struct {
	walk_speed: float,
	close_enough: int @ 0..,
}
dispatch runecraftory:npc_actions[runecraftory:look_at_follow] to struct {
}
dispatch runecraftory:npc_actions[runecraftory:attack_with_weapon] to struct {
}
dispatch runecraftory:npc_actions[runecraftory:attack_with_spell] to struct {
	spell: #[id] #[dispatcher_key="runecraftory:spells"] string,
	ignore_seal: boolean,
	amount?: NumberProvider,
}
dispatch runecraftory:npc_actions[runecraftory:throw_item] to struct {
	items: [ItemStack] @ 1..,
	throw_at_target: boolean,
}
enum(string) NPCActionTypes {
	Idle = "runecraftory:do_nothing",
	#[starred] WalkTo = "runecraftory:walk_to",
	WalkAway = "runecraftory:walk_away",
	KeepDistance = "runecraftory:keep_distance",
	WalkRandomly = "runecraftory:random_walk",
	FollowLeader = "runecraftory:walk_to_follow",
	LookAtLeader = "runecraftory:look_at_follow",
	#[starred] Attack = "runecraftory:attack_with_weapon",
	AttackWithSpell = "runecraftory:attack_with_spell",
	ThrowItem = "runecraftory:throw_item,"
}
struct NPCBehaviour {
	type: NPCActionTypes,
	...runecraftory:npc_actions[[type]]
}
dispatch minecraft:resource[runecraftory:npc_action] to struct NPCActions {
	/// The npc will execute the actions in this list in order
	sequence: [NPCBehaviour],
	predicate?: EntityPredicate,
	time_out: NumberProvider,
	cooldown: NumberProvider,
	weight: int @ 1..,
}

struct LootCondition {
	condition: LootConditionIDS,
	...minecraft:loot_condition[[condition]],
	...runecraftory:loot_condition[[condition]],
}

struct Dialogue {
	translation_key: string,
	/// Optional speaker. Defined in the conversations speaker field
	speaker?: string,
}
struct ConversationActions {
	translation_key:  string,
	actions: ("ANSWER" | "QUEST"),
	value: string,
	friend_xp?: int @ 0..,
}
struct Conversation {
	/// List of dialogues for this conversation
	dialogues: [(string | Dialogue)] @ 1..,
	/// Min required hearts for this conversation
	min_hearts?: NumberProvider,
	/// Max required hearts for this conversation
	max_hearts?: NumberProvider,
	/// Default true. If false npc will never use this to start a conversation. Should be false for action responses
	starting_conversation?: boolean,
	/// List of conversation actions the player can take after this conversation played
	actions?: [ConversationActions],
	/// Allows defining participants in this conversation. Will be referenced by dialogues
	speakers: struct Speakers {
		[string]: struct Speaker {
			npc_id: #[id="runecraftory:npc_data"] string,
			conditions: [LootCondition],
		},
	},
	conditions: [LootCondition],
}

dispatch minecraft:resource[runecraftory:conversation] to struct ConversationSet {
	fallback_key?: string,
	conversations: struct ConversationMap {
		[string]: Conversation
	},
}

enum(string) ScheduleDays {
	#[starred] WeekDays = "WEEKDAYS",
	#[starred] WeekEnd = "WEEKEND",
	Monday = "MONDAY",
	Tuesday ="TUESDAY",
	WedgnesDay = "WEDNESDAY",
	Thursday = "THURSDAY",
	Friday = "FRIDAY",
	Saturday = "SATURDAY",
	Sunday = "SUNDAY",
}

enum(string) ConversationContexts {
	Introduction = "runecraftory:first",
	Greeting = "runecraftory:greeting",
	Talk = "runecraftory:talk",
	TalkWhenFollow = "runecraftory:follow_talk",
	FollowAccept = "runecraftory:follow_yes",
	FollowDecline = "runecraftory:follow_no",
	FollowStop = "runecraftory:follow_stop",
	DefaultGift = "runecraftory:default_gift",
	DatingAccept = "runecraftory:dating_accept",
	DatingDeny = "runecraftory:dating_deny",
	MarriageAccept = "runecraftory:marriage_accept",
	MariageDeny = "runecraftory:marriage_deny",
	Divorce = "runecraftory:divorce",
	DivorceError = "runecraftory:divorce_error",
	ProcreationCooldown = "runecraftory:procreation_cooldown",
}

dispatch minecraft:resource[runecraftory:npc_data] to struct NPCData {
	name?: string,
	surname?: string,
	gender: ("UNDEFINED" | "MALE" | "FEMALE"),
	profession?: #[id] #[dispatcher_key="runecraftory:professions"] string,
	look?: [#[id="runecraftory:look"] string],
	birthday?: struct {
		season: ("SPRING" | "SUMMER" | "FALL" | "WINTER"),
		day: int @ 1..30,
	},
	weight: int @ 0..,
	unique: int @ 0..,
	interactions: struct {
		[ConversationContexts]: #[id="runecraftory:conversations"] string,
	},
	gift_items: struct {
		[string]: struct {
			gift_id: #[id="runecraftory:gift_data"] string,
			response_key: #[id="runecraftory:conversation"] string,
			xp: int,
		},
	},
	relation?: struct {
		relation_ship_state?: ("DEFAULT" | "NON_ROMANCEABLE" | "NO_ROMANCE_NPC" | "NO_ROMANCE"),
		possible_children?: [#[id="runecraftory:npc_data"] string],
		required_quests?: [#[id="simplequests:quest"] string],
	},
	schedule?: struct {
		[ScheduleDays]: [struct {
			time: int @ 0..,
			activity: #[id="minecraft:activity"] string,
			social_chance?: float,
			poi: #[id="minecraft:poi_type"] string,
		}],
	},
	combat?: struct {
		base_level?: int @ 1..,
		combat_actions?: [#[id="runecraftory:npc_actions"] string],
		base_stats?: struct {
			[AttributeIDS]: double,
		},
		stat_increase?: struct {
			[AttributeIDS]: double,
		},
	},
}

dispatch minecraft:resource[runecraftory:npc_look] to struct NPCLook {
	/// If a player skin is used layer settings (such as hair, face etc.) are ignored!
	player_skin?: string,
	gender: ("UNDEFINED" | "MALE" | "FEMALE"),
	weight: int @ 0..,
	additional_features: [LookFeature],
	/// Features that should be enabled only when the given condition is met
	conditional_features: [struct {
		feature: LookFeature,
		predicate: EntityPredicate,
	}]
}

struct LookFeature {
	type: LookFeatureTypes,
	...runecraftory:npc_look_feature[[type]]
}

type ColorSetting = [(#[color="hex_rgb"] int | struct {
	color_min: #[color="hex_rgb"] int,
	color_max: #[color="hex_rgb"] int,
})]
struct IndexedColorSetting {
	/// Which texture to use. For simple features the textures are simply numbered
	indices: [int],
	colors:  ColorSetting,
}
type WeightedIndexedTexture = [struct {
	texture: #[id] string,
	/// Most textures have an index suffix (e.g. outfit/1.png). This allows randomly selecting of based on indices
	range?: struct {
		type: RangeType,
		...runecraftory:range_types[[type]]
	},
	weight: int,
}]
enum(string) RangeType {
	FIRST_N = "FIRST_N",
	RANGE = "RANGE",
	SELECTED = "SELECTED"
}

dispatch runecraftory:range_types[FIRST_N] to struct {
	/// Selects a random int between 0...n (n exclusive)
	amount: int @ 0..,
}
dispatch runecraftory:range_types[RANGE] to struct {
	min: int,
	max:  int,
}
dispatch runecraftory:range_types[SELECTED] to struct {
	/// Selects a random int from the given list
	indices: [int],
}

enum(string) LookFeatureTypes {
	Slim = "runecraftory:slim_feature",
	Size = "runecraftory:size_feature",
	Model = "runecraftory:model_feature",
	Skin = "runecraftory:skin_feature",
	Face = "runecraftory:face_feature",
	Blush = "runecraftory:blush_feature",
	Hair = "runecraftory:hair_feature",
	Chest = "runecraftory:chest_size",
	Outfit = "runecraftory:outfit_feature",
	Hat = "runecraftory:simple_hat_feature",
	Attachments = "runecraftory:model_attachment_feature",
}
dispatch runecraftory:npc_look_feature[runecraftory:slim_feature] to struct {}
dispatch runecraftory:npc_look_feature[runecraftory:size_feature] to struct {
	/// Size of the npc. Clamped between 0.2 and 10
	size: NumberProvider,
}
dispatch runecraftory:npc_look_feature[runecraftory:model_feature] to struct {
	/// A custom model to use
	model?: struct {
		/// Model id. Model path is under path is under assets/<namespace>/tenshilib/models/<path>.geo.json
		model: #[id] string,
		layerPrefix: string,
		texture?: #[id] string,
	},
	/// A custom animation to use. Animation path is under assets/<namespace>/tenshilib/animations/<path>.json
	animation?: #[id] string,
}
dispatch runecraftory:npc_look_feature[runecraftory:skin_feature] to IndexedColorSetting
dispatch runecraftory:npc_look_feature[runecraftory:face_feature] to struct {
	iris: IndexedColorSetting,
	sclera: IndexedColorSetting,
	eyebrow: IndexedColorSetting,
	/// ATM not used
	expressions: struct {
		[string]: struct {
			iris: struct {
				suffix: string,
				use_skin_color: boolean,
			},
			sclera: struct {
				suffix: string,
				use_skin_color: boolean,
			},
			eyebrow: string,
		}
	}
}
dispatch runecraftory:npc_look_feature[runecraftory:blush_feature] to struct {
	chance: float,
	colors:  ColorSetting,
}
dispatch runecraftory:npc_look_feature[runecraftory:hair_feature] to struct {
	/// Hair textures. The texture path is assets/<namespace>/textures/npc/entity/hair/<path>.png
	hairs: WeightedIndexedTexture,
	colors: ColorSetting,
}
dispatch runecraftory:npc_look_feature[runecraftory:chest_size] to struct {
	/// Size of the npcs breasts. Not gender bound. Clamped between 0 and 1 although 0 does not mean nothing
	size: NumberProvider,
}
dispatch runecraftory:npc_look_feature[runecraftory:outfit_feature] to struct {
	/// Outfit textures. The texture path is assets/<namespace>/textures/npc/entity/outfit/<path>.png
	outfits: WeightedIndexedTexture,
}
dispatch runecraftory:npc_look_feature[runecraftory:simple_hat_feature] to struct {
	/// Simple hats. Simple since they will use the main model and simply add a hat layer on top
	hats: [struct {
		/// Hat texture. The texture path is assets/<namespace>/textures/npc/entity/misc/<path>.png
		texture: #[id] string,
		weight: int @ 1..,
	}],
}
type ModelParts = ("HEAD" | "BODY" | "LEFT_ARM" | "RIGHT_ARM" | "LEFT_LEG" | "RIGHT_LEG")
dispatch runecraftory:npc_look_feature[runecraftory:model_attachment_feature] to struct {
	models: [struct {
		/// Model id. Model path is under path is under assets/<namespace>/tenshilib/models/<path>.geo.json
		model: #[id] string,
		/// Animation id. Animation path is under assets/<namespace>/tenshilib/animations/<path>.json
		animation: #[id] string,
		texture: [#[id] string],
		/// What part of the body to attach to
		location: (ModelParts),
		/// What part of the body to hide when this attachment is visible
		hidden: [ModelParts],
	}],
}
